// HSS Kitchens — Prisma schema
// Source of truth: docs/DATA_MODEL.md. Postgres (Supabase); enums as String by design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  role          String        @default("sales") // admin | sales | purchasing | billing | design | viewer
  active        Boolean       @default(true)
  opportunities Opportunity[] @relation("Salesperson")
  orders        Order[]       @relation("OrderOwner")
  lineItems     LineItem[]    @relation("ItemAssignee")
  tasks         Task[]        @relation("TaskAssignee")
  taskComments  TaskComment[]
  serviceIssues ServiceIssue[] @relation("IssueAssignee")
  createdAt     DateTime      @default(now())
}

model Company {
  id             String        @id @default(cuid())
  name           String
  type           String        @default("customer") // lead | customer | lost_lead | vendor | supplier | installer | delivery_partner
  vertical       String? // restaurant | supermarket | healthcare | venue_catering | school | shul | hotel | other
  priorityClient Boolean       @default(false)
  requiresDeposit Boolean      @default(true) // toggle: does this account need a deposit before POs go out?
  depositPercent Int           @default(30) // % of order value required as deposit, when requiresDeposit
  phone          String?
  phoneExt       String?
  cellPhone      String?
  email          String?
  deliveryAddress String?
  billingAddress String?
  locationName   String?
  zip            String?
  website        String?
  notes          String?
  mondayId       String?       @unique
  contacts       Contact[]
  opportunities  Opportunity[]
  orders         Order[]
  suppliedItems  LineItem[]    @relation("ItemSupplier")
  purchaseOrders PurchaseOrder[] @relation("PoSupplier")
  supplierProfile SupplierProfile?
  locations      Location[]
  serviceIssues  ServiceIssue[]
  createdAt      DateTime      @default(now())
}

// A physical site belonging to a business (multi-location customers). Deals and
// orders point at one; the free-text locationName/deliveryAddress on those rows
// stay as the snapshot actually used for delivery - picking a location copies
// its name/address into them.
model Location {
  id            String    @id @default(cuid())
  company       Company   @relation(fields: [companyId], references: [id])
  companyId     String
  name          String
  address       String
  deliveryNotes String?
  contactName   String?
  contactPhone  String?
  isDefault     Boolean   @default(false)
  opportunities Opportunity[]
  orders        Order[]
  serviceIssues ServiceIssue[]
  createdAt     DateTime  @default(now())

  @@index([companyId])
}

model SupplierProfile {
  id                  String  @id @default(cuid())
  company             Company @relation(fields: [companyId], references: [id])
  companyId           String  @unique
  accountNumber       String?
  defaultLeadTimeDays Int?
  repNotes            String?
  preferred           Boolean @default(false)
}

model Contact {
  id        String   @id @default(cuid())
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  firstName String
  lastName  String?
  title     String? // manager | purchasing | billing | other
  email     String?
  phone     String?
  phoneExt  String?
  cellPhone String?
  status    String   @default("active") // active | onboarding | inactive
  notes     String?
  mondayId  String?  @unique
  opportunities Opportunity[]
  orders    Order[]
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Opportunity {
  id               String    @id @default(cuid())
  title            String
  company          Company?  @relation(fields: [companyId], references: [id])
  companyId        String?
  primaryContact   Contact?  @relation(fields: [primaryContactId], references: [id])
  primaryContactId String?
  salesperson      User?     @relation("Salesperson", fields: [salespersonId], references: [id])
  salespersonId    String?
  stage            String    @default("new") // new | info_missing | estimating | proposal_sent | revisions_needed | negotiation | won | lost
  orderType        String    @default("order") // project | order
  needsPricing     Boolean   @default(true)
  value            Float?
  neededByDate     DateTime?
  estDueDate       DateTime?
  nextFollowUp     DateTime?
  lostReason       String?
  // Project intake fields
  facilityType     String?
  menu             String?
  roomDimensions   String?
  wallMeasurements String?
  plumbingElectricalNotes String?
  budget           Float?
  clientVisionNotes String?
  deliveryType     String? // curbside | inside
  openingSize      String?
  installationNeeded Boolean @default(false)
  designStatus     String    @default("none") // none | rendering_in_progress | rendering_approved
  location         Location? @relation(fields: [locationId], references: [id])
  locationId       String?
  locationName     String?
  deliveryAddress  String?
  submittedVia     String    @default("manual") // form | manual
  notes            String?
  mondayId         String?   @unique
  lineItems        LineItem[]
  orders           Order[]
  createdAt        DateTime  @default(now())

  @@index([stage])
  @@index([companyId])
  @@index([salespersonId])
  @@index([nextFollowUp])
  @@index([locationId])
}

model LineItem {
  id             String       @id @default(cuid())
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  opportunityId  String?
  order          Order?       @relation(fields: [orderId], references: [id])
  orderId        String?
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  delivery       Delivery?    @relation(fields: [deliveryId], references: [id])
  deliveryId     String?
  name           String
  description    String?
  moreDetails    String?
  imageUrl       String?
  qty            Int          @default(1)
  itemKind       String       @default("sourced") // sourced | custom_fabrication | service
  brand          String?
  sku            String?
  supplier       Company?     @relation("ItemSupplier", fields: [supplierId], references: [id])
  supplierId     String?
  unitCost       Float?
  unitPrice      Float?
  // The date the item is called for (what the supplier quotes), not a day
  // count: the old `leadTimeDays` column stays in the database (no destructive
  // DDL this pass) but Prisma no longer maps it.
  leadTimeDate   DateTime?
  rfqStatus      String       @default("needs_pricing") // needs_pricing | rfq_sent | quote_received | priced_in_autoquotes | approved | removed
  stockStatus    String       @default("in_stock") // in_stock | backordered - set during pricing, before an order exists
  deliveryStatus String       @default("pending") // pending | ordered | backordered | in_transit_to_hss | in_transit_to_client | arrived_complete
  backorderExpected DateTime? // expected-available date while stockStatus or deliveryStatus = backordered
  dateOrdered    DateTime?
  dateArrivedHss DateTime?
  dateArrivedClient DateTime?
  trackingUrl    String?
  assignee       User?        @relation("ItemAssignee", fields: [assigneeId], references: [id])
  assigneeId     String?
  nextFollowUp   DateTime?
  followedUp     Boolean      @default(false)
  notes          String?
  mondayId       String?      @unique
  serviceIssues  ServiceIssue[]
  createdAt      DateTime     @default(now())

  @@index([rfqStatus])
  @@index([stockStatus])
  @@index([deliveryStatus])
  @@index([opportunityId])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([deliveryId])
  @@index([supplierId])
  @@index([nextFollowUp])
}

model Order {
  id             String       @id @default(cuid())
  title          String
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  opportunityId  String?
  company        Company?     @relation(fields: [companyId], references: [id])
  companyId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  contactId      String?
  owner          User?        @relation("OrderOwner", fields: [ownerId], references: [id])
  ownerId        String?
  orderType      String       @default("order") // project | order
  status         String       @default("new") // new | awaiting_payment | payment_received | pos_in_progress | in_transit | delivery_scheduled | delivered | complete | stuck
  clientPoNumber String?
  jobId          String?
  quickbooksInvoiceNo String?
  orderValue     Float?
  depositRequired Float? // agreed gate amount from the close dialog; null = derive from company depositPercent
  location       Location?    @relation(fields: [locationId], references: [id])
  locationId     String?
  deliveryAddress String?
  neededByDate   DateTime?
  nextFollowUp   DateTime?
  // Payment terms agreed at close (see PAYMENT_TERMS in @/lib/constants). Applying
  // terms writes depositRequired and the source = "terms" payments (see @/lib/terms).
  paymentTerms   String? // deposit_balance | full_upfront | on_delivery | net_30 | custom
  termsNotes     String?
  // Customer-facing quote (projects need one before terms are set; straight orders do not).
  quoteStatus    String       @default("not_needed") // not_needed | needed | sent | accepted
  quoteUrl       String?
  quoteSentAt    DateTime?
  notes          String?
  mondayId       String?      @unique
  lineItems      LineItem[]
  purchaseOrders PurchaseOrder[]
  payments       Payment[]
  deliveries     Delivery[]
  serviceIssues  ServiceIssue[]
  createdAt      DateTime     @default(now())

  @@index([status])
  @@index([companyId])
  @@index([opportunityId])
  @@index([locationId])
  @@index([neededByDate])
  @@index([nextFollowUp])
}

model PurchaseOrder {
  id               String     @id @default(cuid())
  order            Order      @relation(fields: [orderId], references: [id])
  orderId          String
  supplier         Company?   @relation("PoSupplier", fields: [supplierId], references: [id])
  supplierId       String?
  poNumber         String?
  autoQuotesPoNumber String? // the PO number typed into AutoQuotes for this vendor order
  status           String     @default("draft") // draft | sent | acknowledged | shipped | received
  shipTo           String     @default("hss") // hss | client_direct
  sentDate         DateTime?
  ackDate          DateTime?
  // A PO is vendor + AutoQuotes PO # + items. Logistics live on Delivery (one
  // or more legs per PO, created at acknowledgment): trucker, pickup
  // address, scheduled date, ship cost, charged-to-customer, delivery contact
  // phone, delivery status, carrier tracking and ETA. The old PurchaseOrder
  // columns were backfilled into Delivery by
  // prisma/sql/20260903_sales_orders_delivery.sql and are gone from the schema
  // as of Phase 2a-B; the database columns themselves stay in place (no
  // destructive DDL this pass), Prisma simply no longer maps them.
  notes            String?
  lineItems        LineItem[]
  deliveries       Delivery[]
  createdAt        DateTime   @default(now())

  @@unique([orderId, poNumber])
  @@index([orderId])
  @@index([supplierId])
  @@index([status])
}

// One delivery leg, created when its PO is acknowledged (a PO is vendor +
// AutoQuotes # + items; acknowledgment is where it turns into a delivery and
// the mode gets picked). Default one PO -> one Delivery; a delivery can be
// split (items move whole to a second Delivery on the same PO). HSS-stock
// deliveries have no PO. Modes describe which legs apply:
//   manufacturer_to_customer         leg 1 only (drop-ship, carrier tracking)
//   hss_to_customer                  leg 2 only (HSS trucker from stock)
//   manufacturer_to_hss_to_customer  both legs
model Delivery {
  id              String         @id @default(cuid())
  order           Order          @relation(fields: [orderId], references: [id])
  orderId         String
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  mode            String         @default("manufacturer_to_hss_to_customer") // manufacturer_to_customer | hss_to_customer | manufacturer_to_hss_to_customer
  status          String         @default("pending") // pending | scheduled | in_transit | delivered_partial | delivered_full
  // Leg 1 - manufacturer shipment (modes manufacturer_*): carrier tracking + ETA
  trackingCarrier  String?
  trackingUrl      String?
  expectedDelivery DateTime?
  // Leg 2 - HSS trucker to the customer (modes *_to_customer via HSS), modeled on
  // the HSS Delivery Sheet: pickup -> trucker -> client address, cost + billing flag.
  trucker               String?   // carrier or named driver, e.g. "ANDY", "UBER", "UPS DROPSHIP"
  pickupAddress         String?   // defaults from the supplier's address, overridable per leg
  scheduledDeliveryDate DateTime? // the "Schedule Delivery & Trucker" step
  shipCost              Float?    // trucking/delivery cost
  chargedToCustomer     Boolean   @default(false) // was shipCost billed back to the client?
  deliveryContactPhone  String?   // day-of-delivery contact number
  deliveredAt     DateTime?
  notes           String?
  lineItems       LineItem[]
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([status])
}

model Payment {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       String
  type          String // deposit | final | full
  amount        Float
  status        String   @default("pending") // pending | invoiced | paid
  quickbooksRef String?
  date          DateTime?
  source        String   @default("manual") // manual | terms (auto-created by applyTermsToOrder)
  dueNote       String? // e.g. "Balance due before delivery"
  notes         String?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model Task {
  id             String    @id @default(cuid())
  title          String
  notes          String?
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId     String?
  dueDate        DateTime?
  status         String    @default("not_started") // not_started | in_progress | done | stuck
  priority       String    @default("medium") // low | medium | high | critical
  type           String    @default("internal") // internal | customer_service | external
  estimatedHours Float?
  linkedType     String? // opportunity | order | company | contact
  linkedId       String?
  parentTask     Task?     @relation("Subtasks", fields: [parentTaskId], references: [id])
  parentTaskId   String?
  subtasks       Task[]    @relation("Subtasks")
  comments       TaskComment[]
  mondayId       String?   @unique
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([linkedType, linkedId])
}

model TaskComment {
  id         String   @id @default(cuid())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  author     User?    @relation(fields: [authorId], references: [id])
  authorId   String?
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

model IntakeSubmission {
  id          String   @id @default(cuid())
  payload     String // JSON of raw form submission
  submittedAt DateTime @default(now())
  processed   Boolean  @default(false)
  resultType  String? // opportunity | order
  resultId    String?
  mondayId    String?  @unique
}

model Document {
  id         String   @id @default(cuid())
  linkedType String // opportunity | order | company | contact | purchase_order | line_item
  linkedId   String
  kind       String   @default("other") // quote | invoice | drawing | po | tracking | other
  fileUrl    String
  fileName   String?
  source     String   @default("link") // link | upload | google_drive
  mimeType   String?
  sizeBytes  Int?
  storagePath String? // Supabase Storage object path for source = upload
  uploadedBy String?
  note       String?
  uploadedAt DateTime @default(now())

  @@index([linkedType, linkedId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  userName      String?
  linkedType    String
  linkedId      String
  action        String
  detail        String?
  // Structured before/after for the mutation classes the reliability spec
  // singles out (paid/unpaid, PO/delivery status, team role/active, admin
  // settings, RFQ price). Every other call site leaves these null and stays
  // readable through `detail` alone - both render fine in the audit view.
  previousValue String?
  newValue      String?
  sourceScreen  String?
  at            DateTime @default(now())

  @@index([linkedType, linkedId])
  @@index([userName])
  @@index([action])
  @@index([at])
}

// Admin-configurable required fields (Settings tab). The shipped set lives in
// @/lib/fieldRequirements; this table only ever holds an override per field,
// so a missing row means "use the shipped default" (see getFieldRequirements).
model FieldRequirement {
  id       String  @id @default(cuid())
  entity   String // company | opportunity
  field    String // e.g. phone, email, companyId, neededByDate
  required Boolean @default(true)

  @@unique([entity, field])
}

// Customer-service log. An issue can hang off a company, one of its locations,
// an order and/or a single line item - whichever is known when it is reported.
model ServiceIssue {
  id          String    @id @default(cuid())
  company     Company?  @relation(fields: [companyId], references: [id])
  companyId   String?
  location    Location? @relation(fields: [locationId], references: [id])
  locationId  String?
  order       Order?    @relation(fields: [orderId], references: [id])
  orderId     String?
  lineItem    LineItem? @relation(fields: [lineItemId], references: [id])
  lineItemId  String?
  title       String
  description String?
  status      String    @default("open") // open | in_progress | resolved | closed
  priority    String    @default("medium") // low | medium | high | critical (TASK_PRIORITIES)
  assignee    User?     @relation("IssueAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([assigneeId])
  @@index([orderId])
  @@index([companyId])
  @@index([locationId])
  @@index([lineItemId])
}

// Admin-configurable per-role overrides of the shipped permission matrix in
// @/lib/permissions - same pattern as FieldRequirement: a missing row means
// "use the shipped default" (see getRolePermissions in @/lib/permissionsServer).
model RolePermission {
  id         String  @id @default(cuid())
  role       String // admin | sales | purchasing | billing | design | viewer
  permission String // e.g. deals.close, pos.edit (see PERMISSIONS)
  allowed    Boolean @default(true)

  @@unique([role, permission])
}

// Key/value app settings (company details for PO PDFs, default service
// assignee, ...). Typed keys live in @/lib/settings.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
